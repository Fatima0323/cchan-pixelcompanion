{
  "manifest_version": 3,
  "name": "Claude 娘 · 像素陪伴",
  "version": "0.7.3",
  "description": "在 claude.ai 页面上放一只像素 Claude 娘：同步显示 Claude 的输出，完成时叮一声，需要确认时举手提醒。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude 娘",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "notifications"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "sounds.js", "sprite-art.js", "sprite.js", "book.js", "anim-art.js", "anim-book.js", "anim-logo-art.js", "anim-logo.js", "fx-blackhole.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
